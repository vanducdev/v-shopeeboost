{
  "manifest_version": 3,
  "name": "V-ShopeeBoost Pro Max",
  "short_name": "ShopeeBoost",
  "version": "6.0.0",
  "description": "Quản lý đa tài khoản Shopee chuyên nghiệp v6.0.0 Pro Max. Cookie manager, Proxy Auth tự động, chống rò rỉ WebRTC, vân tay chuẩn.",
  "author": "VMaxTech",
  "homepage_url": "https://app.vmaxtech.vn/",
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "privacy"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "V-ShopeeBoost — Quản Lý Tài Khoản Shopee"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["fingerprint.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.shopee.vn/*",
        "https://*.shopee.com/*",
        "https://*.shopee.sg/*",
        "https://*.shopee.my/*",
        "https://*.shopee.co.id/*",
        "https://*.shopee.ph/*",
        "https://*.shopee.tw/*",
        "https://*.shopee.co.th/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fingerprint.json",
        "fingerprint.js",
        "icons/*",
        "image/*",
        "pages/*"
      ],
      "matches": [
        "<all_urls>",
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
